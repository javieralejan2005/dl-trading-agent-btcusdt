# Copia este archivo a .env y completa SOLO en tu equipo. NUNCA subas .env al repositorio.
# Clave secreta para proteger la API del backend (genera una larga y aleatoria):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AGENT_API_KEY=
# Ollama corre solo en local; el backend es la única puerta de acceso.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=
# Datos públicos de MEXC: no requieren clave. NO añadas claves de trading.
MEXC_BASE_URL=https://api.mexc.com
SYMBOL=BTCUSDT
INTERVAL=1d
DB_PATH=data/agent.db
# Modo: "live" (consulta MEXC) o "replay" (repetición histórica etiquetada como replay)
RUN_MODE=live
